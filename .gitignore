ShareGPT4V/
*.json.zip
*.tar
*.tar.gz

# Local secrets / env files
.env
.env.*
*.token
secrets.yaml

# Isolated pinned evaluation environment and source checkout
.venv-lmms-eval/
third_party/lmms-eval-v0.7.1/

# Benchmark datasets over 50 MB (keep local; Git cannot ignore by file size).
/evaluation/MMBench/mmbench_dev_en_20231003.tsv
/evaluation/MMStar/MMStar.tsv

# Video evaluation predictions/provenance remain local; compact validation reports
# are retained under each experiment's reports/ directory.
/experiments/*/video_evaluation/

# Resumable all-data downloader state and isolated dependency environment.
/.data-download/
/.data-download-venv/
/.data-download.lock
/ShareGPT4V/.data-download.lock

# Raw evaluation artifacts and caches stay local at any experiment depth.
# Curated metrics, figures, reports and provenance under reports/ are versionable.
results/
results_*/
outputs/
